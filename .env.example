APP_NAME="Ermis Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ermis_backend
DB_USERNAME=postgres
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Mail Configuration
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@ermis.com
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# External Voice APIs
ORPHEUS_STREAMING_API=
ORPHEUS_MALE_API=
ORPHEUS_FEMALE_API=
SPARK_TTS_API=
MIRA_TTS_API=
YOURTTS_MALE_API=
YOURTTS_FEMALE_API=
STT_API=

# Chat APIs
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1/models/gemini-2.5-flash:generateContent

# Biometria & Deepfake APIs
BIOMETRIA_API=
DEEPFAKE_API=
