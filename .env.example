APP_NAME="POC São José dos Pinhais"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Oracle Database (gvenzl/oracle-free:23-slim)
DB_CONNECTION=oracle
DB_HOST=oracle
DB_PORT=1521
DB_DATABASE=FREEPDB1
DB_USERNAME=poc_user
DB_PASSWORD=poc_pass
ORACLE_SYS_PASSWORD=oraclepass

CACHE_STORE=redis
SESSION_DRIVER=file
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Mail Configuration (opcional para POC)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@pmsjp.pr.gov.br
MAIL_FROM_NAME="${APP_NAME}"
