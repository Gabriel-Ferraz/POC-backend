FROM registry.dev.hugyourcustomer.ai/huglabs/php8.2:latest

ARG UID=1000
ARG GID=1000

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Sao_Paulo

# Install additional development dependencies (git)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    git \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Create app user matching host UID/GID to avoid permission issues on Linux
RUN groupadd -g ${GID} appgroup 2>/dev/null || groupmod -g ${GID} appgroup \
    && useradd -u ${UID} -g ${GID} -m -s /bin/bash appuser 2>/dev/null || usermod -u ${UID} -g ${GID} appuser

WORKDIR /app

COPY docker/php/php-dev.ini /etc/php/8.2/cli/php.ini
COPY docker/entrypoint-dev.sh /usr/local/bin/entrypoint-dev.sh

RUN chmod +x /usr/local/bin/entrypoint-dev.sh \
    && sed -i 's/\r//' /usr/local/bin/entrypoint-dev.sh

EXPOSE 3333

ENTRYPOINT ["/usr/local/bin/entrypoint-dev.sh"]
