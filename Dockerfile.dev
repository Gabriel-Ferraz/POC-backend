FROM php:8.2-cli-bookworm

ARG UID=1000
ARG GID=1000

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Sao_Paulo

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl unzip wget libaio1 libzip-dev libpng-dev libjpeg-dev libxml2-dev \
    libonig-dev libgd-dev libssl-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Oracle Instant Client 21.9 (license accepted implicitly per Oracle's OTN terms)
RUN mkdir -p /opt/oracle && cd /opt/oracle \
    && wget -q "https://download.oracle.com/otn_software/linux/instantclient/219000/instantclient-basiclite-linux.x64-21.9.0.0.0dbru.zip" \
    && wget -q "https://download.oracle.com/otn_software/linux/instantclient/219000/instantclient-sdk-linux.x64-21.9.0.0.0dbru.zip" \
    && unzip -q instantclient-basiclite-linux.x64-21.9.0.0.0dbru.zip \
    && unzip -q instantclient-sdk-linux.x64-21.9.0.0.0dbru.zip \
    && rm -f *.zip \
    && echo /opt/oracle/instantclient_21_9 > /etc/ld.so.conf.d/oracle-instantclient.conf \
    && ldconfig

ENV LD_LIBRARY_PATH="/opt/oracle/instantclient_21_9"
ENV ORACLE_HOME="/opt/oracle/instantclient_21_9"

# OCI8 PHP extension
RUN echo "instantclient,/opt/oracle/instantclient_21_9" | pecl install oci8-3.3.0 \
    && docker-php-ext-enable oci8

# Swoole extension
RUN pecl install swoole \
    && docker-php-ext-enable swoole

# Redis extension (phpredis)
RUN pecl install redis \
    && docker-php-ext-enable redis

# Other PHP extensions needed by Laravel
RUN docker-php-ext-install pdo zip opcache bcmath mbstring exif gd sockets pcntl

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Create app user matching host UID/GID
RUN groupadd -g ${GID} appgroup 2>/dev/null || groupmod -g ${GID} appgroup \
    && useradd -u ${UID} -g ${GID} -m -s /bin/bash appuser 2>/dev/null || usermod -u ${UID} -g ${GID} appuser

WORKDIR /app

COPY docker/php/php-dev.ini /usr/local/etc/php/conf.d/php-dev.ini
COPY docker/entrypoint-dev.sh /usr/local/bin/entrypoint-dev.sh

RUN chmod +x /usr/local/bin/entrypoint-dev.sh \
    && sed -i 's/\r//' /usr/local/bin/entrypoint-dev.sh

EXPOSE 3333

ENTRYPOINT ["/usr/local/bin/entrypoint-dev.sh"]
