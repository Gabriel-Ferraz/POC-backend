# syntax=docker/dockerfile:1.4
FROM ubuntu:22.04

ARG UID=1000
ARG GID=1000

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Sao_Paulo

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# System deps + PHP 8.2 PPA
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    ca-certificates \
    gnupg \
    curl \
    unzip \
    git \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    && add-apt-repository ppa:ondrej/php -y \
    && apt-get update && apt-get install -y --no-install-recommends \
    php8.2-cli \
    php8.2-mbstring \
    php8.2-xml \
    php8.2-zip \
    php8.2-curl \
    php8.2-bcmath \
    php8.2-gd \
    php8.2-pgsql \
    php8.2-opcache \
    php8.2-swoole

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Create app user matching host UID/GID to avoid permission issues on Linux
RUN groupadd -g ${GID} appgroup 2>/dev/null || groupmod -g ${GID} appgroup \
    && useradd -u ${UID} -g ${GID} -m -s /bin/bash appuser 2>/dev/null || usermod -u ${UID} -g ${GID} appuser

WORKDIR /app

COPY composer.json composer.lock ./
COPY package*.json ./

RUN --mount=type=cache,target=/root/.composer/cache,sharing=locked \
    composer install --no-interaction --prefer-dist --no-scripts --no-autoloader

COPY docker/php/php-dev.ini /etc/php/8.2/cli/php.ini
COPY docker/entrypoint-dev.sh /usr/local/bin/entrypoint-dev.sh

RUN chmod +x /usr/local/bin/entrypoint-dev.sh

EXPOSE 3333

ENTRYPOINT ["/usr/local/bin/entrypoint-dev.sh"]
